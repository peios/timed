{
    "side_effects": ["man-db"],
    "package": {
        "name": "dev.peios.timed",
        "description": "Peios authenticated network time synchronisation service",
        "version": "0.1.10-1",
        "architecture": "x86_64",
        "license_class": "free",
        "homepage": "https://github.com/peios/timed"
    },
    "dependencies": {
        "dev.peios.libpeios": ">= 0.5.12-1",
        "org.gnu.glibc": "*",
        "org.gnu.gcc-libgcc": "*",
        "sh": "*",
        "dev.peios.peiosutils": "*",
        "dev.peios.libtrust": ">= 0.1.6-1",
        "dev.peios.libresolvd": ">= 0.1.6-1"
    },
    "files": {
        "source:LICENSE": "usr/share/licenses/dev.peios.timed/LICENSE",
        "stage:licenses/timed/**": "usr/share/licenses/dev.peios.timed/third-party",
        "stage:usr/sbin/timed": "usr/sbin/timed",
        "stage:usr/libexec/timed/prepare-state": "usr/libexec/timed/prepare-state",
        "stage:usr/share/regim/timed-service.reg": "usr/share/regim/timed-service.reg",
        "stage:usr/share/regim/timed-policy.reg": "usr/share/regim/timed-policy.reg",
        "stage:usr/share/regman/timed.regman": "usr/share/regman/timed.regman",
        "source:docs/timed.evman": "usr/share/evman/timed.evman",
        "stage:usr/share/man/man8/timed.8.gz": "usr/share/man/man8/timed.8.gz"
    },
    "license_component": "timed",
    "executables": ["usr/sbin/timed", "usr/libexec/timed/prepare-state"]
}

#!/bin/sh
# Give timed a directory it can own.
#
# Run as SYSTEM by ExecStartPre, because timed cannot do this itself:
# peinit provisions /run/<service> and nothing else, and /var/state is
# SYSTEM-owned, so a LocalService daemon has no way to make a directory
# there. Running timed as SYSTEM instead would hand the run of the machine
# to the one daemon on it that parses hostile network input.
#
# Everything here is idempotent: the hook runs on every start, including
# every restart, and must not care whether it has run before.
exec > /var/state/timed-prepare.log 2>&1
set -x
set -e

TIMED_SID='S-1-5-80-2061758774-2413367500-3090050229-3167896262-4120155161'
STATE=/var/state/timed

mkdir -p "$STATE"

# A complete protected inheritance scope. `sd allow --replace` only replaces
# ACEs for the named principals; it leaves an inherited Everyone grant intact.
# Establish this before timed can create any cookie files.
sd set "$STATE" "O:SYG:SYD:P(A;OICI;GA;;;SY)(A;OICI;GA;;;BA)(A;OICI;GA;;;$TIMED_SID)"

mkdir -p "$STATE/cookies"

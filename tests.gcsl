# Each owned member's documentation tests.
def test doctests(
    ran: List<List<{}>> = for each in MEMBERS { = rust.doctests(crates(), each, given = loaded(), env = LIBRARIES) },
) {}

# Clippy's checks of each owned member, every warning denied.
def test clippy(checked: List<List<{}>> = for each in MEMBERS { = rust.clippy(crates(), each, flags = ["-Dwarnings"]) }) {}

# Builds the C program `source` against the public headers `include` and
# the client library `library`, linked as `-l{name}` from `at`, and runs it
# against the library by its soname, `lib{name}.so.1`.
fn called(
    library: File,
    name: String,
    at: String,
    libpeios: List<{at: String, place: Dir | File}>,
    include: Dir,
    source: File,
    c: toolchain.CToolchain,
) -> {} {
    let home = working_dir().path
    let made = fs.mkdir("{home}/out")
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = c.runtime},
        {at = "/opt/cc"; place = c.root},
        {at = "/work/out"; place = dir("{home}/out")},
        {at = "/work/include"; place = include},
        {at = "/work/abi.c"; place = source},
        {at = "{at}/lib{name}.so"; place = library},
        {at = "{at}/lib{name}.so.1"; place = library},
        ...(for each in libpeios { = {at = each.at; place = each.place} }),
    ]
    let box = fs.compose(placed).sandbox(cwd = "/work", env = {LD_LIBRARY_PATH = "/opt/peios/lib:{at}"})
    let cc = c.cc.path.strip_prefix(c.root.path)
    let compiled = box.exec(
        "/opt/cc{cc}",
        "-UNDEBUG",
        "-I/work/include",
        "/work/abi.c",
        "-o",
        "/work/out/abi",
        "-L{at}",
        "-Wl,-rpath-link,/opt/peios/lib",
        "-l{name}",
    )
    let ran = box.exec("/work/out/abi")
}

# The C client's ABI: a C program that includes its public header and links
# it calls it.
def test abi(
    library: File = build libtimed(),
    libpeios: List<{at: String, place: Dir | File}> = peios_rs.runtime(),
    include: Dir = dir("libtimed/include"),
    source: File = file("libtimed/tests/abi.c"),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
) {
    = called(library, "timed", LIBTIMED, libpeios, include, source, c)
}

# The vendored resolvd client's ABI, as Bazel checked it.
def test resolvd_c_abi(
    library: File = build libresolvd(),
    libpeios: List<{at: String, place: Dir | File}> = peios_rs.runtime(),
    include: Dir = dir("vendor/resolvd/libresolvd/include"),
    source: File = file("vendor/resolvd/libresolvd/tests/abi.c"),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
) {
    = called(library, "resolvd", LIBRESOLVD, libpeios, include, source, c)
}

# The vendored trustd client's ABI, as Bazel checked it.
def test trust_c_abi(
    library: File = build libtrust(),
    libpeios: List<{at: String, place: Dir | File}> = peios_rs.runtime(),
    include: Dir = dir("vendor/trustd/libtrust/include"),
    source: File = file("vendor/trustd/libtrust/tests/abi.c"),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
) {
    = called(library, "trust", LIBTRUST, libpeios, include, source, c)
}

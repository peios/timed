# timed's tests: each member's unit and integration tests, as `cargo test
# -p` builds them, the vendored crates' among them, the C ABI of timed's
# client library and of the vendored resolvd and trustd ones, each owned
# member's documentation tests, as `cargo test --doc` runs them, and
# Clippy's checks, as `cargo clippy --all-targets -- -Dwarnings` makes them.
#
# A test's own code runs in a hermetic step of its own, so what it plans,
# builds or fetches is in its parameters' defaults.
import fs
import toolchain
import Toolchain from toolchain
import "github.com/gcslib/rust"
import "github.com/peios/peios-rs" as peios_rs

# timed's own members, each a directory of the same name. The crates it
# vendors are their components' to check.
let MEMBERS = ["libtimed", "timed-client", "timed-abi", "ntp", "timed-core", "timed", "clock"]

# Where the client libraries are placed, as `build.gcsl` places them for
# the client crates.
let LIBTIMED = "/opt/timed/lib"

let LIBRESOLVD = "/opt/resolvd/lib"

let LIBTRUST = "/opt/trust/lib"

# Where the tests find the shared libraries they load.
let LIBRARY_PATH = "/opt/peios/lib:{LIBTIMED}:{LIBRESOLVD}:{LIBTRUST}"

let LIBRARIES = [{key = "LD_LIBRARY_PATH"; value = LIBRARY_PATH}]

# What every test is given: libpeios, by its soname, which a program that
# links it loads (see peios-rs's `runtime`), and the client libraries, by
# their sonames, which the client crates load.
def loaded() -> List<{at: String, place: Dir | File}> {
    = [
        ...peios_rs.runtime(),
        {at = "{LIBTIMED}/libtimed.so.1"; place = build libtimed()},
        {at = "{LIBRESOLVD}/libresolvd.so.1"; place = build libresolvd()},
        {at = "{LIBTRUST}/libtrust.so.1"; place = build libtrust()},
    ]
}

# Runs each of `tests`, given `given`.
fn ran(tests: List<rust.RustTest>, given: List<{at: String, place: Dir | File}>) -> {} {
    let each = for test in tests { = rust.run_test(test, given = given, env = LIBRARIES) }
}

def test libtimed(
    tests: List<rust.RustTest> = rust.tests(crates(), "libtimed"),
    given: List<{at: String, place: Dir | File}> = loaded(),
) {
    = ran(tests, given)
}

def test timed_client(
    tests: List<rust.RustTest> = rust.tests(crates(), "timed-client"),
    given: List<{at: String, place: Dir | File}> = loaded(),
) {
    = ran(tests, given)
}

